PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/stakesync
# true only for a throwaway local database; normally migrations run on boot
DB_SYNC=false

# Where the apps live (links in emails, OAuth redirects, CORS)
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Security. Generate with: openssl rand -base64 48 / openssl rand -base64 32
JWT_SECRET=
# 32 bytes, base64. Encrypts OAuth tokens and admin 2FA secrets.
ENCRYPTION_KEY=
ACCESS_TTL_SECS=900
REFRESH_TTL_DAYS=30

# Hardening (see docs/security.md)
# Proxies in front of the API: 1 behind one load balancer, 0 when exposed directly
TRUST_PROXY=0
# Admins must use an authenticator app (on by default in production)
ADMIN_REQUIRE_2FA=true
# Optional: only these IPs (or prefixes ending in ".") can use admin endpoints, e.g. 102.89.1.7,10.0.
ADMIN_IP_ALLOWLIST=
# 'true' makes higher-value challenges require Verified/Enhanced accounts (age, linked accounts). Off for now.
ENFORCE_ACCOUNT_LEVELS=
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# Server and error log retention, in days
LOG_KEEP_INFO_DAYS=14
LOG_KEEP_WARN_DAYS=30
LOG_KEEP_ERROR_DAYS=90

# Sign-in and connections (all free). Redirect URI to register: {APP_URL}/auth/callback/{provider}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WAKATIME_CLIENT_ID=
WAKATIME_CLIENT_SECRET=

# Solana escrow (see docs/solana-integration.md)
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Read-only RPC for verifying devnet activity (deploy challenges)
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
STAKE_SYNC_PROGRAM_ID=ANKCFRDYu45J199F1teNEeCiRUC7xYRArMtiHRYkvAcV
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
TREASURY_WALLET=
# Secret keys as base58 or a JSON byte array. Use a KMS/HSM in production.
# Verifier: records results on-chain. Must match Config.verifier.
VERIFIER_SECRET_KEY=
# Platform: creates challenge escrows, pays network fees and rent top-ups, cranks settlement. Keep some SOL in it.
PLATFORM_SECRET_KEY=
# SOL sent to a wallet that can't cover account rent when joining (about 0.003), capped per wallet per day
RENT_DRIP_LAMPORTS=3000000
RENT_DRIPS_PER_DAY=3
# false stops the background chain jobs (useful for local testing)
CHAIN_WORKERS=true

# Local currency in and out: LocalRamp (default once its public key is set; no partner fee) or Onramper.
# USDC goes straight to the person's own wallet either way. See docs/localramp.md.
# ONRAMP_PROVIDER=localramp | onramper (optional; defaults to LocalRamp when LOCALRAMP_PUBLIC_KEY is set)
ONRAMP_PROVIDER=
LOCALRAMP_PUBLIC_KEY=
LOCALRAMP_SECRET_KEY=
# Set the same value as the webhook token in the LocalRamp dashboard; webhook URL: {API_URL}/api/payments/onramp/localramp/webhook
LOCALRAMP_WEBHOOK_TOKEN=
# LocalRamp's codes for USDC on Solana (confirm with GET /v1/transaction/buy/currencies once you have keys)
LOCALRAMP_BUY_CURRENCY=USDC_SOL
LOCALRAMP_SELL_CURRENCY=USDC
LOCALRAMP_SELL_CHAIN=SOL

# Onramper (alternative provider)
# Generate an Ed25519 key pair, send Onramper the public key, put the private key (PEM) here.
#   openssl genpkey -algorithm ed25519 -out onramper.pem && openssl pkey -in onramper.pem -pubout
ONRAMPER_API_KEY=
ONRAMPER_SIGNING_KEY=
# Staging: https://buy.onramper.dev with a pk_test_ key
ONRAMPER_BASE_URL=https://buy.onramper.com
ONRAMPER_USDC_ID=usdc_sol
ONRAMPER_DEFAULT_FIAT=NGN
# Webhooks record top-ups in money history (docs/onramper.md). Register {API_URL}/api/payments/onramp/webhook
# with Onramper first; they issue the secret. Off by default: the widget links work without them.
ONRAMPER_WEBHOOKS_ENABLED=false
ONRAMPER_WEBHOOK_SECRET=
# Leave these off until the sell payload and the transactions API are confirmed with Onramper.
ONRAMPER_SELL_WEBHOOKS_ENABLED=false
ONRAMPER_RECONCILE_ENABLED=false
# Staging: https://api-stg.onramper.com (used only by reconciliation)
ONRAMPER_API_URL=https://api.onramper.com

# Embedded wallets (Privy, free up to ~500 monthly users). Signs short-lived tokens so Privy trusts our sign-in.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Paste as one line with \n between lines. In Privy, set the JWKS URL to {API_URL}/api/auth/wallet-token/jwks.json
WALLET_AUTH_PRIVATE_KEY=

# Email (Brevo free plan: 300/day). A v3 API key from SMTP & API > API Keys. Empty = emails are logged in development.
# MAIL_FROM must be verified in Brevo (Senders, Domains & Dedicated IPs). No domain yet? Verify a single address
# (e.g. your Gmail) under Senders; Brevo then sends from @brevosend.com, and replies come back to MAIL_FROM.
BREVO_API_KEY=
MAIL_FROM=Stake-Sync <stakesync2@gmail.com>

# Browser push (free). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:stakesync2@gmail.com

# Uploads. Set CLOUDINARY_URL (Cloudinary free plan) and uploads go there; empty = local disk (development only).
# Copy it from Cloudinary: Settings > API Keys > "API environment variable": cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Optional override: local | cloudinary | s3 (any S3-compatible store, with the S3_* settings below)
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Verification engine
VERIFY_UNAVAILABLE_GRACE_HOURS=24
