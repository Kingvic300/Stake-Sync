VITE_API_URL=http://localhost:3000/api

# Solana: mainnet-beta (production) | devnet (testing). RPC defaults to the public endpoint for the cluster;
# use a dedicated provider (Helius, Triton, QuickNode) in production.
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC=
# e.g. https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional override; defaults to Circle's USDC mint for the cluster
VITE_USDC_MINT=
# Privy app ID: creates wallets for people new to crypto (see the backend's docs/embedded-wallets.md). Empty = connect your own wallet.
VITE_PRIVY_APP_ID=
# 'true' turns on paying in local currency and bank cash-outs (LocalRamp). Otherwise they say "Coming soon".
VITE_ONRAMP_ENABLED=

# Jupiter swap API for converting SOL to USDC (mainnet only). Defaults to the free https://lite-api.jup.ag/swap/v1
VITE_JUPITER_API=
